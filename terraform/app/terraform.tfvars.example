# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# Terraform automatically reads terraform.tfvars.

# The context created by `aws eks update-kubeconfig` (see the eks/ outputs).
# List all with: kubectl config get-contexts
kube_context = "arn:aws:eks:eu-central-1:362099375729:cluster/ugergo-finaltask"

# A commit SHA that the GitHub Actions pipeline pushed to ECR.
# List them with:
#   aws ecr describe-images --repository-name ugergo/finaltask --query 'imageDetails[].imageTags' --output text
image_tag = "489488485808a15933dab49a016cde2130e99915"
